SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_APP_API_KEY=generate-a-random-32-byte-secret

# Shared dashboard login (server-only)
APP_USERNAME=reviewer
APP_PASSWORD=choose-a-strong-password
APP_SESSION_SECRET=generate-a-random-48-byte-secret

# Encrypts each workspace's Zernio key before database storage
ZERNIO_ENCRYPTION_KEY=generate-a-random-32-byte-base64-key

# Cloudflare media Worker (server-only signing secret)
MEDIA_WORKER_URL=https://content-approval-media.your-workers-subdomain.workers.dev
UPLOAD_SIGNING_SECRET=generate-a-random-32-byte-secret
