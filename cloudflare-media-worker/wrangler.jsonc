{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "content-approval-media",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "content-approval-media"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://approve-content-review.vercel.app,http://localhost:3000"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
